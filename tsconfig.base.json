{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "paths": {
      "@doc-rag/contracts": ["./libs/contracts/src/index.ts"],
      "@doc-rag/config": ["./libs/config/src/index.ts"],
      "@doc-rag/ai": ["./libs/ai/src/index.ts"],
      "@doc-rag/chunking": ["./libs/chunking/src/index.ts"],
      "@doc-rag/document-processing": ["./libs/document-processing/src/index.ts"],
      "@doc-rag/embeddings": ["./libs/embeddings/src/index.ts"],
      "@doc-rag/pdf-processing": ["./libs/pdf-processing/src/index.ts"],
      "@doc-rag/queue": ["./libs/queue/src/index.ts"],
      "@doc-rag/retrieval": ["./libs/retrieval/src/index.ts"],
      "@doc-rag/storage": ["./libs/storage/src/index.ts"],
      "@doc-rag/testing": ["./libs/testing/src/index.ts"],
      "@doc-rag/database": ["./libs/database/src/index.ts"]
    }
  }
}
